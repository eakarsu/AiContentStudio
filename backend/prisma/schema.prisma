generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int      @id @default(autoincrement())
  email            String   @unique
  password         String
  name             String
  role             String   @default("editor") // admin, editor, viewer
  tenantId         String?
  avatar           String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  lastLogin        DateTime?
  loginCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  videos             Video[]
  audioFiles         Audio[]
  textContents       TextContent[]
  images             Image[]
  translations       Translation[]
  summaries          Summary[]
  seoContents        SEOContent[]
  socialPosts        SocialPost[]
  emails             Email[]
  blogPosts          BlogPost[]
  marketingCopy      MarketingCopy[]
  scripts            Script[]
  podcasts           Podcast[]
  voiceovers         Voiceover[]
  musicTracks        MusicTrack[]
  contentCalendars   ContentCalendar[]
  repurposedContents RepurposedContent[]
  plagiarismChecks   PlagiarismCheck[]
  imageSuggestions   ImageSuggestion[]
  performancePredictions PerformancePrediction[]
  blogOutlines       BlogOutline[]
  newsletters        Newsletter[]
  pressReleases      PressRelease[]
  passwordResets     PasswordReset[]
  apiKeys            ApiKey[]
  auditLogs          AuditLog[]
  contentVersions    ContentVersion[]
  brandVoice         BrandVoice?
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model ApiKey {
  id        Int      @id @default(autoincrement())
  name      String
  key       String   @unique
  lastUsed  DateTime?
  expiresAt DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // create, update, delete, generate, login, etc.
  resource   String   // video, audio, user, etc.
  resourceId Int?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  status      String   @default("pending")
  videoUrl    String?
  thumbnail   String?
  duration    Int?
  style       String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Audio {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  status      String   @default("pending")
  audioUrl    String?
  duration    Int?
  voice       String?
  language    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model TextContent {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  content     String?
  status      String   @default("pending")
  type        String
  wordCount   Int?
  tone        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Image {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  prompt      String
  status      String   @default("pending")
  imageUrl    String?
  style       String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Translation {
  id             Int      @id @default(autoincrement())
  title          String
  originalText   String
  translatedText String?
  sourceLang     String
  targetLang     String
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         Int
  user           User     @relation(fields: [userId], references: [id])
}

model Summary {
  id           Int      @id @default(autoincrement())
  title        String
  originalText String
  summary      String?
  length       String
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
}

model SEOContent {
  id           Int      @id @default(autoincrement())
  title        String
  keyword      String
  content      String?
  metaTitle    String?
  metaDesc     String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
}

model SocialPost {
  id        Int      @id @default(autoincrement())
  title     String
  platform  String
  prompt    String
  content   String?
  hashtags  String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Email {
  id        Int      @id @default(autoincrement())
  title     String
  type      String
  prompt    String
  subject   String?
  body      String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  topic     String
  keywords  String?
  content   String?
  excerpt   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model MarketingCopy {
  id          Int      @id @default(autoincrement())
  title       String
  product     String
  targetAud   String?
  content     String?
  headline    String?
  callToAction String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Script {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  topic       String
  content     String?
  duration    Int?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Podcast {
  id          Int      @id @default(autoincrement())
  title       String
  topic       String
  description String?
  script      String?
  audioUrl    String?
  duration    Int?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model Voiceover {
  id          Int      @id @default(autoincrement())
  title       String
  text        String
  voice       String
  language    String?
  audioUrl    String?
  duration    Int?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model MusicTrack {
  id          Int      @id @default(autoincrement())
  title       String
  genre       String
  mood        String?
  prompt      String
  audioUrl    String?
  duration    Int?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

// NEW MODELS FOR AI CONTENT STUDIO FEATURES

model ContentCalendar {
  id                Int      @id @default(autoincrement())
  title             String
  contentType       String   // blog, social, email, video, etc.
  scheduledDate     DateTime
  platform          String?
  topic             String
  status            String   @default("pending") // pending, scheduled, published, draft
  content           String?
  aiSuggestions     String?
  contentBrief      String?
  keyPoints         String?
  suggestedHashtags String?
  bestTimeToPost    String?
  contentHooks      String?
  callToAction      String?
  relatedTopics     String?
  visualSuggestions String?
  toneGuidance      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
}

model RepurposedContent {
  id              Int      @id @default(autoincrement())
  title           String
  originalContent String
  originalType    String   // blog, video, podcast, etc.
  targetType      String   // social, email, thread, summary, etc.
  targetPlatform  String?
  repurposedContent String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
}

model PlagiarismCheck {
  id                Int      @id @default(autoincrement())
  title             String
  content           String
  originalityScore  Float?
  plagiarismScore   Float?
  analysisReport    String?
  flaggedSections   String?
  suggestions       String?
  overallAssessment String?
  uniqueElements    String?
  commonPhrases     String?
  potentialConcerns String?
  readability       String?
  voiceConsistency  String?
  toneAppropriate   String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
}

model ImageSuggestion {
  id                 Int      @id @default(autoincrement())
  title              String
  content            String   // The content to analyze
  contentType        String   // blog, social, email, etc.
  suggestions        String?  // JSON array of image suggestions
  imagePrompts       String?  // AI-generated prompts for image generation
  stockKeywords      String?  // Keywords for stock image search
  colorPalette       String?
  brandingNotes      String?
  accessibilityNotes String?
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
}

model PerformancePrediction {
  id                    Int      @id @default(autoincrement())
  title                 String
  content               String
  contentType           String   // blog, social, email, video, etc.
  platform              String?
  predictedScore        Float?
  engagementPrediction  String?
  viralityScore         Float?
  recommendations       String?
  analysisDetails       String?
  strengthAnalysis      String?
  weaknessAnalysis      String?
  audienceAppeal        String?
  timingRecommendations String?
  competitiveAnalysis   String?
  hashtagSuggestions    String?
  headlineAlternatives  String?
  status                String   @default("pending")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  userId                Int
  user                  User     @relation(fields: [userId], references: [id])
}

model BlogOutline {
  id                Int      @id @default(autoincrement())
  title             String
  topic             String
  targetAudience    String?
  keywords          String?
  outline           String?  // JSON structure with sections
  estimatedLength   Int?
  seoScore          Float?
  suggestions       String?
  subtitle          String?
  metaDescription   String?
  estimatedReadTime String?
  targetKeywords    String?
  contentHooks      String?
  callToAction      String?
  relatedTopics     String?
  visualSuggestions String?
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            Int
  user              User     @relation(fields: [userId], references: [id])
}

model Newsletter {
  id                      Int      @id @default(autoincrement())
  title                   String
  topic                   String
  audience                String?
  frequency               String?  // daily, weekly, monthly
  sections                String?  // JSON array of sections
  content                 String?
  subject                 String?
  preheader               String?
  callToAction            String?
  alternativeSubjectLines String?
  sendTimeSuggestion      String?
  segmentationSuggestion  String?
  status                  String   @default("pending")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  userId                  Int
  user                    User     @relation(fields: [userId], references: [id])
}

model PressRelease {
  id                 Int      @id @default(autoincrement())
  title              String
  companyName        String
  announcement       String
  targetMedia        String?  // tech, business, general, industry
  tone               String?  // professional, urgent, friendly, corporate
  targetAudience     String?
  product            String?
  quotes             String?
  content            String?
  headline           String?
  subheadline        String?
  boilerplate        String?
  contactInfo        String?
  dateline           String?
  leadParagraph      String?
  mediaAngle         String?
  targetPublications String?
  followUpTips       String?
  socialMediaTeaser  String?
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
}

// Content versioning — snapshot of any content item before overwrite
model ContentVersion {
  id          Int      @id @default(autoincrement())
  contentType String   // video, blog, text, pressRelease, etc.
  contentId   Int
  version     Int
  data        Json     // full snapshot of the content row at the time of version
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  @@index([contentType, contentId])
}

// Brand voice profile learned from user writing samples
model BrandVoice {
  id               Int      @id @default(autoincrement())
  tone             String?  // formal, casual, authoritative, friendly
  sentenceLength   String?  // short, medium, long, varied
  vocabularyLevel  String?  // simple, moderate, advanced
  commonPhrases    Json?    // array of characteristic phrases
  styleTraits      Json?    // full extracted style characteristics object
  sampleTexts      Json?    // the input samples used to build this profile
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           Int      @unique
  user             User     @relation(fields: [userId], references: [id])
}

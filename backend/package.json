  "description": "AI Content Studio Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon --delay 2 --signal SIGTERM src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma migrate deploy",
